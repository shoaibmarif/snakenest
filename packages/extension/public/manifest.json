{
  "manifest_version": 3,
  "name": "SnakeNest – Classic Retro Snake Game",
  "version": "1.0.0",
  "description": "Play the classic Snake Game directly in your browser popup. 4 battle modes, difficulty levels, local high scores, retro sound effects, and offline play.",
  "homepage_url": "https://snakenest.netlify.app/",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

